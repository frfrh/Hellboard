<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HellboardCompanion.App.CompanionApp"
             Name="Hellboard Companion"
             RequestedThemeVariant="Default">

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/hellboard.ico"
                ToolTipText="Hellboard Companion"
                Clicked="OnTrayIconClicked">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Open" Click="OnOpenClicked" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Exit" Click="OnExitClicked" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>

</Application>
