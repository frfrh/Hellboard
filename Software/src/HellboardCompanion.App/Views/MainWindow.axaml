<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:HellboardCompanion.App.ViewModels"
        xmlns:views="using:HellboardCompanion.App.Views"
        mc:Ignorable="d"
        d:DesignWidth="1200" d:DesignHeight="900"
        x:Class="HellboardCompanion.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/hellboard.ico"
        Title="{Binding Title}"
        Width="1200" Height="900"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <x:Static Member="vm:MainWindowViewModel.DesignInstance" />
  </Design.DataContext>

  <Window.Resources>
    <!-- Large stratagem tile (overview) -->
    <DataTemplate x:Key="LargeTile" x:DataType="vm:StratagemTileViewModel">
      <Border Width="150" Height="170" Margin="0,0,12,0" CornerRadius="6" Background="#2F2F2F" Padding="10">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Panel Width="88" Height="88">
            <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="88" Height="88" />
            <TextBlock Text="–" IsVisible="{Binding !HasIcon}" FontSize="36" Foreground="#606060"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
          <TextBlock Text="{Binding Name}" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="130" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Foreground="#FFC107" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="130" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Small stratagem tile (multi-function list, history) -->
    <DataTemplate x:Key="SmallTile" x:DataType="vm:StratagemTileViewModel">
      <Border Margin="0,0,8,8" CornerRadius="4" Background="#2F2F2F" Padding="6" ToolTip.Tip="{Binding Name}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="32" Height="32" />
          <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="Horizontal">
      <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <ItemsPanelTemplate x:Key="Wrap">
      <WrapPanel />
    </ItemsPanelTemplate>
  </Window.Resources>

  <Panel>
  <views:HexBackground />
  <TabControl Margin="12,8">

    <!-- ===================================================== Overview -->
    <TabItem Header="Overview">
      <ScrollViewer>
        <StackPanel Margin="12" Spacing="20" DataContext="{Binding Overview}" x:DataType="vm:OverviewViewModel">

          <!-- Chain game → recognition → Hellboard: whole entries move to the next line when the window gets narrow -->
          <WrapPanel Margin="0,0,0,-10">
            <WrapPanel.Styles>
              <Style Selector="Border.status">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="#20808080" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="MinWidth" Value="250" />
                <Setter Property="MaxWidth" Value="360" />
              </Style>
              <Style Selector="Border.status TextBlock.text">
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              </Style>
              <Style Selector="Border.status TextBlock.detail">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.65" />
              </Style>
            </WrapPanel.Styles>
            <Border Classes="status" ToolTip.Tip="{Binding GameLine.FullText}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Ellipse Width="14" Height="14" Fill="{Binding GameBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="text" Text="{Binding GameLine.Text}" />
                  <TextBlock Classes="detail" Text="{Binding GameLine.Detail}" IsVisible="{Binding GameLine.Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="status" ToolTip.Tip="{Binding RecognitionLine.FullText}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Ellipse Width="14" Height="14" Fill="{Binding RecognitionBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="text" Text="{Binding RecognitionLine.Text}" />
                  <TextBlock Classes="detail" Text="{Binding RecognitionLine.Detail}" IsVisible="{Binding RecognitionLine.Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="status" ToolTip.Tip="{Binding HellboardLine.FullText}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Ellipse Width="14" Height="14" Fill="{Binding HellboardBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="text" Text="{Binding HellboardLine.Text}" />
                  <TextBlock Classes="detail" Text="{Binding HellboardLine.Detail}" IsVisible="{Binding HellboardLine.Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
              </Grid>
            </Border>
          </WrapPanel>

          <!-- Loadout -->
          <StackPanel Spacing="10">
            <TextBlock Text="Loadout" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding LoadoutTitle}" Opacity="0.7" />
            <ItemsControl ItemsSource="{Binding Stratagems}" ItemTemplate="{StaticResource LargeTile}" ItemsPanel="{StaticResource Horizontal}" />
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="{Binding MultiFunctionTitle}" FontSize="16" FontWeight="SemiBold" />
            <!-- Groups by origin, each in a thin frame; groups and tiles wrap, a tile never breaks -->
            <ItemsControl ItemsSource="{Binding MultiFunctionGroups}" ItemsPanel="{StaticResource Wrap}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MultiFunctionGroupViewModel">
                  <Border BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="6" Padding="8,4,0,0" Margin="0,0,10,10">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Title}" FontSize="11" Opacity="0.6" />
                      <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource SmallTile}" ItemsPanel="{StaticResource Wrap}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Border IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Background="#33FFC107" BorderBrush="#FFC107" BorderThickness="1" CornerRadius="4" Padding="12">
            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Recognize loadout now" Command="{Binding RecognizeNowCommand}" IsVisible="{Binding IsGameRunning}"
                    ToolTip.Tip="Only while Helldivers 2 is running; not while it is minimized." />
            <Button Content="Set as default on the Hellboard" Command="{Binding HellboardStatus.SetAsDefaultCommand}"
                    ToolTip.Tip="Saves the current loadout in the Hellboard's flash; it is used after power-up without the Companion." />
            <TextBlock Text="{Binding HellboardStatus.DefaultResult}" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ===================================================== Hellboard -->
    <TabItem Header="Hellboard">
      <ScrollViewer>
        <StackPanel Margin="12" Spacing="22" MaxWidth="980" HorizontalAlignment="Left"
                    DataContext="{Binding HellboardTab}" x:DataType="vm:HellboardViewModel">

          <StackPanel Spacing="10">
            <TextBlock Text="Connection" FontSize="18" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
              <TextBlock Grid.Row="0" Text="Status" Opacity="0.7" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.Connection}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Text="Firmware" Opacity="0.7" />
              <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.Firmware}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Text="Last loadout sent" Opacity="0.7" />
              <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Status.LastSent}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Text="Default loadout" Opacity="0.7" VerticalAlignment="Center" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Content="Set as default on the Hellboard" Command="{Binding Status.SetAsDefaultCommand}"
                        ToolTip.Tip="Saves the current loadout in the Hellboard's flash; it is used after power-up without the Companion." />
                <TextBlock Text="{Binding Status.DefaultResult}" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" MaxWidth="420" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Status.Warning}" IsVisible="{Binding Status.Warning, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="#FFC107" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="Firmware" FontSize="18" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8">
              <TextBlock Grid.Row="0" Text="On the Hellboard" Opacity="0.7" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BoardFirmware}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Text="Included in the Companion" Opacity="0.7" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BundledFirmware}" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Text="A newer firmware is available for this Hellboard." IsVisible="{Binding IsUpdateAvailable}" Foreground="#FFC107" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !IsConfirmingUpdate}">
              <Button Content="Update Hellboard firmware …" Command="{Binding RequestUpdateCommand}"
                      ToolTip.Tip="Installs the firmware included in the Companion on the Hellboard." />
              <TextBlock Text="{Binding UpdateResult}" VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap" MaxWidth="560" />
            </StackPanel>
            <Border IsVisible="{Binding IsConfirmingUpdate}" BorderBrush="#FFC107" BorderThickness="1" CornerRadius="4" Padding="12">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding UpdateDetails}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Start update" Command="{Binding StartUpdateCommand}" />
                  <Button Content="Cancel" Command="{Binding CancelUpdateCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding UpdateSteps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" Opacity="0.8" FontFamily="Consolas,Menlo,monospace" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="Configuration" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Changes are sent to the Hellboard immediately and stay in its memory until it restarts. Save them on the Hellboard to keep them without the Companion." />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
              <TextBlock Grid.Row="0" Text="Button 1-1" VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Stratagems}" SelectedItem="{Binding FixedButton1}" MinWidth="320" MaxDropDownHeight="400" />

              <TextBlock Grid.Row="1" Text="Button 1-2" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Stratagems}" SelectedItem="{Binding FixedButton2}" MinWidth="320" MaxDropDownHeight="400" />

              <TextBlock Grid.Row="2" Text="Stratagem key (as in the game)" VerticalAlignment="Center" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ModifierKeys}" SelectedItem="{Binding ModifierKey}" MinWidth="320" MaxDropDownHeight="400" />

              <TextBlock Grid.Row="3" Text="Stratagem key mode" VerticalAlignment="Center" />
              <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ModifierModes}" SelectedItem="{Binding ModifierMode}" MinWidth="320" />

              <TextBlock Grid.Row="4" Text="Direction keys" VerticalAlignment="Center" />
              <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding DirectionKeyChoices}" SelectedItem="{Binding DirectionKeys}" MinWidth="320" />

              <TextBlock Grid.Row="5" Text="Key timings" VerticalAlignment="Top" Margin="0,6,0,0" />
              <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                <TextBlock Grid.Row="0" Text="Wait for the stratagem menu" VerticalAlignment="Center" MinWidth="200" />
                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding MenuDelayMs}" Minimum="0" Maximum="{Binding MaxMenuDelay}" Increment="10" FormatString="0" Width="140" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="ms" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="Hold each arrow" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding KeyPressMs}" Minimum="{Binding MinKeyDelay}" Maximum="{Binding MaxKeyDelay}" Increment="5" FormatString="0" Width="140" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="ms" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Text="Pause between arrows" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding KeyReleaseMs}" Minimum="{Binding MinKeyDelay}" Maximum="{Binding MaxKeyDelay}" Increment="5" FormatString="0" Width="140" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="ms" VerticalAlignment="Center" />
              </Grid>

              <TextBlock Grid.Row="6" Text="LED brightness" VerticalAlignment="Center" />
              <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <Slider Value="{Binding Brightness}" Minimum="0" Maximum="255" Width="260" />
                <TextBlock Text="{Binding BrightnessText}" VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock Grid.Row="7" Text="Hellboard log level" VerticalAlignment="Center" />
              <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" MinWidth="320" />

              <TextBlock Grid.Row="8" Text="Display: long names" VerticalAlignment="Center" />
              <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding ScrollTextChoices}" SelectedItem="{Binding ScrollText}" MinWidth="320" />

              <TextBlock Grid.Row="9" Text="Display: screen saver" VerticalAlignment="Top" Margin="0,6,0,0" />
              <StackPanel Grid.Row="9" Grid.Column="1" Spacing="4">
                <ComboBox ItemsSource="{Binding ScreenSaverChoices}" SelectedItem="{Binding ScreenSaver}" MinWidth="320" />
                <TextBlock Text="Turns the display off when no button is pressed, against OLED burn-in. Stratagem buttons keep working; the cycle button wakes the display." Opacity="0.6" FontSize="12" TextWrapping="Wrap" MaxWidth="520" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
              <Button Content="Save configuration on the Hellboard" Command="{Binding SaveConfigCommand}"
                      ToolTip.Tip="Writes this configuration to the Hellboard's flash, so it is used after power-up without the Companion." />
              <TextBlock Text="{Binding SaveResult}" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" MaxWidth="460" />
            </StackPanel>
            <TextBlock Text="{Binding ConfigState}" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Hellboard log (newest first)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ComboBox ItemsSource="{Binding LogFilters}" SelectedItem="{Binding LogFilter}" PlaceholderText="All" MinWidth="200" />
                <Button Content="Copy" Click="OnCopyHellboardLogClicked" ToolTip.Tip="Copies the visible log lines (for bug reports)" />
                <Button Content="Clear" Command="{Binding ClearLogCommand}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="No log entries yet – they appear as soon as a Hellboard with the new firmware is connected."
                       IsVisible="{Binding !HasLog}" Opacity="0.6" TextWrapping="Wrap" />
            <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Padding="8" IsVisible="{Binding HasLog}">
              <ScrollViewer MaxHeight="360">
                <ItemsControl ItemsSource="{Binding LogLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HellboardLogLineViewModel">
                      <Grid ColumnDefinitions="70,60,*" Margin="0,1">
                        <TextBlock Grid.Column="0" Text="{Binding Time}" Opacity="0.7" FontFamily="Consolas,Menlo,monospace" />
                        <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{Binding LevelBrush}" FontFamily="Consolas,Menlo,monospace" />
                        <SelectableTextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ===================================================== Stratagems (editor) -->
    <TabItem Header="Stratagems">
      <Grid Margin="12" ColumnDefinitions="380,*" RowDefinitions="Auto,*,Auto" ColumnSpacing="20" RowSpacing="12"
            DataContext="{Binding StratagemEditor}" x:DataType="vm:StratagemEditorViewModel">

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="4">
          <TextBlock Text="Stratagems and input codes" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Opacity="0.7" TextWrapping="Wrap"
                     Text="Add the code of a new stratagem or correct an existing one. Your changes are kept in your own list and stay when the Companion or the icons are updated. They apply immediately; the Hellboard gets the new code with the next transfer." />
        </StackPanel>

        <!-- list -->
        <DockPanel Grid.Row="1" Grid.Column="0">
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
            <TextBox Text="{Binding SearchText}" PlaceholderText="Search" />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <CheckBox IsChecked="{Binding OnlyWithoutCode}" Content="Only without code" />
              <CheckBox IsChecked="{Binding OnlyWithReference}" Content="Only with reference" />
            </StackPanel>
            <CheckBox IsChecked="{Binding OnlyWithProposal}" Content="Only with wiki.gg proposal" />
            <TextBlock Text="{Binding Summary}" Opacity="0.6" FontSize="12" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StratagemEditorItem">
                <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
                  <Image Grid.Column="0" Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="36" Height="36" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CodeArrows}" FontSize="13" Opacity="0.8" />
                    <TextBlock Text="{Binding SourceText}" FontSize="11" Opacity="0.55" />
                    <TextBlock Text="wiki.gg lists another code" FontSize="11" Foreground="#FFC107" IsVisible="{Binding HasProposal}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- editing -->
        <ScrollViewer Grid.Row="1" Grid.Column="1">
          <StackPanel Spacing="12" MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Text="Select a stratagem on the left." IsVisible="{Binding !HasSelection}" Opacity="0.6" />
            <StackPanel Spacing="12" IsVisible="{Binding HasSelection}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Image Source="{Binding Selected.Icon}" Width="72" Height="72" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Selected.FullName}" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Selected.Id}" Opacity="0.6" />
                  <TextBlock Text="{Binding Selected.Source}" Opacity="0.6" />
                </StackPanel>
              </StackPanel>

              <Border IsVisible="{Binding Selected.HasProposal, FallbackValue=False}" BorderBrush="#FFC107" BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="Code proposal from helldivers.wiki.gg" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Selected.ProposalText}" TextWrapping="Wrap" />
                  <TextBlock Opacity="0.7" TextWrapping="Wrap" FontSize="12"
                             Text="The wiki is maintained by players and can be wrong. Take the code over only if it is right – best check it in the game. Keeping the current code hides this proposal until the wiki lists yet another code." />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Take over wiki code" Command="{Binding TakeOverWikiCodeCommand}" />
                    <Button Content="Keep current code" Command="{Binding DismissWikiCodeCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                <TextBlock Grid.Row="0" Text="Name on the Hellboard" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditName}" MaxLength="64" />
                <TextBlock Grid.Row="1" Text="Category (LED color)" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding EditCategory}" MinWidth="240" />
              </Grid>

              <TextBlock Text="Input code" FontWeight="SemiBold" />
              <Border x:Name="CodeInput" Focusable="True" KeyDown="OnCodeKeyDown" PointerPressed="OnCodeInputPressed"
                      BorderBrush="#808080" BorderThickness="1" CornerRadius="6" Padding="14" Background="#20808080">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding EditCodeArrows}" FontSize="34" />
                  <TextBlock Text="Click here and type with the arrow keys or W A S D; Backspace removes the last arrow." Opacity="0.6" FontSize="12" />
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="↑" FontSize="18" Width="48" Command="{Binding AddArrowCommand}" CommandParameter="U" />
                <Button Content="↓" FontSize="18" Width="48" Command="{Binding AddArrowCommand}" CommandParameter="D" />
                <Button Content="←" FontSize="18" Width="48" Command="{Binding AddArrowCommand}" CommandParameter="L" />
                <Button Content="→" FontSize="18" Width="48" Command="{Binding AddArrowCommand}" CommandParameter="R" />
                <Button Content="⌫ Remove last" Command="{Binding RemoveArrowCommand}" Margin="12,0,0,0" />
                <Button Content="Clear" Command="{Binding ClearCodeCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding CodeProblem}" IsVisible="{Binding CodeProblem, Converter={x:Static ObjectConverters.IsNotNull}}"
                         Foreground="#FFC107" TextWrapping="Wrap" />

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Save" Command="{Binding SaveCommand}" />
                <Button Content="Remove my change" Command="{Binding ResetCommand}"
                        ToolTip.Tip="Restores the built-in code, or removes your own stratagem from your list." />
              </StackPanel>
              <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Opacity="0.85" />

              <TextBlock Text="Reference images" FontWeight="SemiBold" Margin="0,8,0,0" />
              <TextBlock Text="{Binding Selected.ReferenceText}" TextWrapping="Wrap" Opacity="0.8" />
              <Button Content="Remove reference images" Command="{Binding RemoveReferencesCommand}" HorizontalAlignment="Left"
                      ToolTip.Tip="Deletes the slot images you assigned to this stratagem in the History tab." />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- your list -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
          <TextBlock VerticalAlignment="Center" Opacity="0.6" TextWrapping="Wrap" MaxWidth="700">
            <Run Text="Your list: " />
            <Run Text="{Binding UserFile}" />
          </TextBlock>
          <Button Content="Export …" Click="OnExportStratagemsClicked" ToolTip.Tip="Saves your list to a file, e.g. to share it." />
          <Button Content="Import …" Click="OnImportStratagemsClicked" ToolTip.Tip="Adds the stratagems of a shared list to yours." />
        </StackPanel>
      </Grid>
    </TabItem>

    <!-- ===================================================== Settings -->
    <TabItem Header="Settings">
      <ScrollViewer>
        <StackPanel Margin="12" Spacing="22" MaxWidth="820" HorizontalAlignment="Left"
                    DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">

          <StackPanel Spacing="10">
            <TextBlock Text="Recognition" FontSize="18" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
              <TextBlock Grid.Row="0" Text="Mode" VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding RecognitionModes}" SelectedItem="{Binding RecognitionMode}" MinWidth="280" />

              <TextBlock Grid.Row="1" Text="Hotkey for manual recognition" VerticalAlignment="Center" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding HotkeyText}" Width="180" />
                <Button Content="Apply" Command="{Binding ApplyHotkeyCommand}" />
                <TextBlock Text="{Binding HotkeyStatus}" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" MaxWidth="300" />
              </StackPanel>

              <TextBlock Grid.Row="2" Text="Test mode" VerticalAlignment="Center" />
              <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding TestMode}"
                        Content="Manual recognition only shows the result, nothing is locked in or sent" />

              <TextBlock Grid.Row="3" Text="Test data" VerticalAlignment="Center" />
              <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding SaveSnapshotOnTrigger}"
                        Content="Save the frames of every manual recognition as PNG" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="Hellboard" FontSize="18" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="10">
              <TextBlock Grid.Row="0" Text="Connection" VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ConnectionModes}" SelectedItem="{Binding ConnectionMode}" MinWidth="280" />

              <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding PortText}" Width="180" PlaceholderText="automatic" />
                <Button Content="Apply" Command="{Binding ApplyPortCommand}" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="Multi-function button" FontSize="18" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
              <TextBlock Grid.Row="0" Text="Content" VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding MultiFunctionModes}" SelectedItem="{Binding MultiFunctionMode}" MinWidth="280" />

              <TextBlock Grid.Row="1" Text="Fixed list" VerticalAlignment="Top" Margin="0,6,0,0" />
              <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FixedList}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StratagemTileViewModel">
                    <Border CornerRadius="4" Background="#20808080" Padding="6" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Image Grid.Column="0" Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Foreground="#FFC107" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                          <Button Content="↑" ToolTip.Tip="Move up"
                                  Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MoveUpCommand}" CommandParameter="{Binding}" />
                          <Button Content="↓" ToolTip.Tip="Move down"
                                  Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MoveDownCommand}" CommandParameter="{Binding}" />
                          <Button Content="Remove"
                                  Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveStratagemCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Grid.Row="2" Text="Add" VerticalAlignment="Center" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ComboBox ItemsSource="{Binding AvailableStratagems}" SelectedItem="{Binding StratagemToAdd}" MinWidth="280" MaxDropDownHeight="400" />
                <Button Content="Add" Command="{Binding AddStratagemCommand}" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="Stratagem data and icons" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Stratagem names and input codes come from the Helldivers wiki (helldivers.wiki.gg): new stratagems and missing codes are added automatically, a different code of a known stratagem is only proposed in the Stratagems tab. The icons used for recognition come from the wiki, too. Both are checked at most once a day." />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Check now" Command="{Binding CheckIconsCommand}" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding WikiStatus}" TextWrapping="Wrap" MaxWidth="560" />
                <TextBlock Text="{Binding IconStatus}" TextWrapping="Wrap" MaxWidth="560" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding IconsWithoutCode}" IsVisible="{Binding IconsWithoutCode, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="#FFC107" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" />
            <CheckBox IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding AutostartAvailable}" Content="Start Hellboard Companion with Windows" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8">
              <TextBlock Grid.Row="0" Text="On start, show" VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding StartChoices}" SelectedItem="{Binding StartMinimized}" MinWidth="320" />
              <TextBlock Grid.Row="1" Text="Close button (X)" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CloseChoices}" SelectedItem="{Binding CloseButton}" MinWidth="320" />
            </Grid>
            <Grid ColumnDefinitions="220,*" ColumnSpacing="16">
              <TextBlock Text="Game process" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding ProcessNameText}" Width="180" />
                <Button Content="Apply" Command="{Binding ApplyProcessNameCommand}" />
              </StackPanel>
            </Grid>
            <TextBlock Opacity="0.6" TextWrapping="Wrap">
              <Run Text="Settings are saved automatically in " />
              <Run Text="{Binding ConfigFile}" />
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ===================================================== History -->
    <TabItem Header="History">
      <ScrollViewer>
        <StackPanel Margin="12" Spacing="10" DataContext="{Binding History}" x:DataType="vm:HistoryViewModel">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="History (newest first)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Show" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" MinWidth="280" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding FilePath}" Opacity="0.6" />
          <ItemsControl ItemsSource="{Binding Entries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                <Panel>
                  <!-- Locked loadout -->
                  <Border IsVisible="{Binding IsLoadout}" CornerRadius="4" Background="#20808080" Padding="10" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Time}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Title}" Opacity="0.7" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Stratagems}" ItemTemplate="{StaticResource SmallTile}" ItemsPanel="{StaticResource Horizontal}" />
                      <TextBlock Opacity="0.7">
                        <Run Text="Mission stratagems: " />
                        <Run Text="{Binding MissionStratagems}" />
                      </TextBlock>
                    </StackPanel>
                  </Border>
                  <!-- Problem -->
                  <Border IsVisible="{Binding IsProblem}" CornerRadius="4" Background="#22FFC107" BorderBrush="#99FFC107" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Panel Grid.Column="0" VerticalAlignment="Top">
                        <Image Source="{Binding ProblemImage}" IsVisible="{Binding HasProblemImage}" MaxHeight="140" MaxWidth="320" Stretch="Uniform" />
                        <Image Source="{Binding ProblemStratagem.Icon}" IsVisible="{Binding HasProblemStratagem}" Width="64" Height="64" />
                      </Panel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock Text="{Binding Time}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Title}" Foreground="#FFC107" />
                        </StackPanel>
                        <SelectableTextBlock Text="{Binding ProblemText}" TextWrapping="Wrap" />
                        <!-- Unrecognized slot: assign it as reference image -->
                        <StackPanel IsVisible="{Binding HasReference}" Spacing="4" Margin="0,4,0,0">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="This is" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding Reference.Choices}" SelectedItem="{Binding Reference.Selected}" MinWidth="260"
                                      PlaceholderText="Choose the stratagem …" />
                            <Button Content="Use as reference" Command="{Binding Reference.AssignCommand}"
                                    ToolTip.Tip="Stores this slot image locally; the recognition uses it instead of the icon of this stratagem" />
                          </StackPanel>
                          <TextBlock Text="{Binding Reference.Result}" IsVisible="{Binding Reference.Result, Converter={x:Static ObjectConverters.IsNotNull}}"
                                     TextWrapping="Wrap" Opacity="0.8" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ===================================================== Diagnostics -->
    <TabItem Header="Diagnostics">
      <ScrollViewer>
        <Grid Margin="12" ColumnDefinitions="440,*" ColumnSpacing="24">

          <StackPanel Grid.Column="0" Spacing="16">
            <Border IsVisible="{Binding HasSupportNote}"
                    Background="#33FFC107" BorderBrush="#FFC107" BorderThickness="1"
                    CornerRadius="4" Padding="12">
              <TextBlock Text="{Binding SupportNote}" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="Helldivers 2" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Status" Opacity="0.7" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GameStatus}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Monitor" Opacity="0.7" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GameMonitor}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Game area" Opacity="0.7" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GameClientArea}" />
              <TextBlock Grid.Row="3" Grid.Column="0" Text="Window mode" Opacity="0.7" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GameWindowMode}" />
            </Grid>

            <TextBlock Text="Recognition" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Screen" Opacity="0.7" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Loadout.Screen}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Ready button" Opacity="0.7" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Loadout.ReadyStatus}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Stratagems" Opacity="0.7" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Loadout.PlayerStratagems}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Grid.Column="0" Text="Mission" Opacity="0.7" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Loadout.MissionStratagems}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Grid.Column="0" Text="Tracker" Opacity="0.7" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Loadout.TrackerState}" />
              <TextBlock Grid.Row="5" Grid.Column="0" Text="Last locked" Opacity="0.7" />
              <SelectableTextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Loadout.LastLocked}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="6" Grid.Column="0" Text="Icons" Opacity="0.7" />
              <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Loadout.Icons}" />
            </Grid>

            <TextBlock Text="Application" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Opacity="0.7" VerticalAlignment="Center" />
              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <SelectableTextBlock Text="{Binding FullVersion}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="260" />
                <Button Content="Copy" Click="OnCopyVersionClicked" ToolTip.Tip="Copies the full version (for bug reports)" />
              </StackPanel>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Operating system" Opacity="0.7" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OperatingSystem}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Configuration" Opacity="0.7" />
              <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConfigDirectory}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Grid.Column="0" Text="Logs" Opacity="0.7" />
              <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LogDirectory}" TextWrapping="Wrap" />
            </Grid>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="12">
            <TextBlock Text="Capture" FontSize="16" FontWeight="SemiBold" />
            <Border Background="#20000000" CornerRadius="4" MinHeight="200">
              <Image Source="{Binding Capture.Preview}" Stretch="Uniform" MaxHeight="400" />
            </Border>
            <TextBlock Text="{Binding Capture.CaptureInfo}" Opacity="0.7" />
            <Border IsVisible="{Binding Capture.IsBlack}"
                    Background="#33F44336" BorderBrush="#F44336" BorderThickness="1"
                    CornerRadius="4" Padding="12">
              <TextBlock TextWrapping="Wrap"
                         Text="The captured image is black. The game probably runs in exclusive fullscreen – switch to borderless window mode." />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Save snapshot" Command="{Binding Capture.SaveSnapshotCommand}" />
              <Button Content="Open snapshot folder" Click="OnOpenSnapshotFolderClicked" />
            </StackPanel>
            <SelectableTextBlock Text="{Binding Capture.LastSnapshot}" TextWrapping="Wrap" Opacity="0.7" />

            <TextBlock Text="Manual recognition" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock Text="{Binding Manual.HotkeyInfo}" Opacity="0.7" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Recognize now" Command="{Binding Manual.RecognizeNowCommand}" />
              <Button Content="Analyze image file…" Click="OnAnalyzeImageFileClicked" />
            </StackPanel>
            <SelectableTextBlock Text="{Binding Manual.Result}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </TabItem>

  </TabControl>
  </Panel>
</Window>
