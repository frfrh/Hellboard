<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral: must not reference Windows-only APIs (implementation plan §3.1). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\layouts\loadout-v1.json" LogicalName="HellboardCompanion.Core.Layout.loadout-v1.json" />
    <!-- Single source of the stratagem input codes, shared with the firmware (repository root). -->
    <EmbeddedResource Include="..\..\..\doc\stratagems.json" LogicalName="HellboardCompanion.Core.Hellboard.stratagems.json" Link="stratagems.json" />
    <!-- Firmware bundle for the updater in the Companion (implementation plan §6.10); the stratagem list is generated from the catalog. -->
    <EmbeddedResource Include="..\..\..\Firmware\manifest.json;..\..\..\Firmware\config.json;..\..\..\Firmware\main.py" LogicalName="Firmware/%(Filename)%(Extension)" Link="Firmware\%(Filename)%(Extension)" Visible="false" />
    <EmbeddedResource Include="..\..\..\Firmware\libs\**\*.py" LogicalName="Firmware/libs/%(RecursiveDir)%(Filename)%(Extension)" Link="Firmware\libs\%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

</Project>
